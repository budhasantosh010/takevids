# Local runtime. Defaults to .takevids-runtime when omitted.
TAKEVIDS_RUNTIME_ROOT=.takevids-runtime

# Private prompt/skill files. Keep this path gitignored unless intentionally publishing them.
TAKEVIDS_INSTRUCTIONS_ROOT=.takevids-private/instructions

# Container image used for true executable isolation when Docker is available.
TAKEVIDS_AGENT_IMAGE=takevids-agent:local

# Real model execution — server only.
# Local LiteLLM proxy default: http://127.0.0.1:4000/v1
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Real transcription — configure when WhisperX is added.
WHISPERX_MODEL=large-v3

# Internet storage — intentionally deferred until multi-user testing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
